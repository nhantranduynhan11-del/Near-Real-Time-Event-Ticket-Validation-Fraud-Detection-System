
DB_HOST_INTERNAL=sqlserver
DB_HOST_EXTERNAL=localhost
DB_PORT=1433
DB_NAME=ticket_system
DB_USER=sa
DB_PASSWORD=
DB_ENCRYPT=false
DB_COLLATION=Vietnamese_CI_AS


KAFKA_INTERNAL=kafka:29092
KAFKA_EXTERNAL=localhost:9092
KAFKA_TOPIC=scan-events
KAFKA_DLQ_TOPIC=scan-events-dlq


API_PORT=3000
TZ=Asia/Ho_Chi_Minh
ACTIVE_EVENT_ID=EV001
# Bắt buộc: sinh bằng `openssl rand -hex 32`. Thiếu thì API không khởi động.
# QR_HMAC_SECRET tối thiểu 32 ký tự; đổi secret thì mọi QR đã in mất hiệu lực.
QR_HMAC_SECRET=
JWT_SECRET=
JWT_EXPIRES_IN=12h
SCAN_WAIT_MS=3000
FRAUD_CONFIG_PATH=./config/fraud-rules.json
