
DB_HOST_INTERNAL=sqlserver
DB_HOST_EXTERNAL=localhost
DB_PORT=1433
DB_NAME=ticket_system
DB_USER=sa
DB_PASSWORD=
DB_ENCRYPT=false
DB_COLLATION=Vietnamese_CI_AS


KAFKA_INTERNAL=kafka:29092
KAFKA_EXTERNAL=localhost:9092
KAFKA_TOPIC=scan-events
KAFKA_DLQ_TOPIC=scan-events-dlq


API_PORT=3000
TZ=Asia/Ho_Chi_Minh
ACTIVE_EVENT_ID=EV001
# Bắt buộc: sinh bằng `openssl rand -hex 32`. Thiếu thì API không khởi động.
# QR_HMAC_SECRET tối thiểu 32 ký tự; đổi secret thì mọi QR đã in mất hiệu lực.
QR_HMAC_SECRET=
JWT_SECRET=
JWT_EXPIRES_IN=12h
SCAN_WAIT_MS=3000
FRAUD_CONFIG_PATH=./config/fraud-rules.json

# Optional: set both API variables or leave both empty.
# Dedicated username: api_user.
# If both are empty, use the default DB credentials.
DB_USER_API=
DB_PASSWORD_API=
# Tài khoản database riêng của Spark (B4), tạo bằng database/security_spark.sql. Để trống cả hai thì
# Spark dùng DB_USER/DB_PASSWORD (sa). Spark tự kiểm quyền lúc khởi động và in câu GRANT còn thiếu.
# Optional: set both Spark variables or leave both empty.
# Dedicated username: spark_user.
# Never commit real passwords to Git.
SPARK_DB_USER=
SPARK_DB_PASSWORD=
